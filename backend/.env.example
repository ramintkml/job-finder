# Telegram (get from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_BOT_USERNAME=KayaProjectsBot

# Review bot — REQUIRED token. Bot talks to EVERY user who opens it (multi-user).
# Create a bot via @BotFather. Users each /start in their own private chat.
TELEGRAM_REVIEW_BOT_TOKEN=

# OPTIONAL admin chat — receipt alerts (usually same number as your user id)
TELEGRAM_REVIEW_CHAT_ID=

# REQUIRED for admin panel — your Telegram user id(s), comma-separated
# Get it from @userinfobot, then put here, e.g. TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_ADMIN_IDS=

# Phase 2 — VPS queues heavy work for the PC worker
# On VPS: QUEUE_HEAVY_WORK=true and set a shared secret
# On PC worker: same WORKER_API_SECRET + WORKER_REMOTE_URL (tunnel default)
QUEUE_HEAVY_WORK=false
WORKER_API_SECRET=
WORKER_REMOTE_URL=http://127.0.0.1:8000
# WORKER_ID=pc-main
# WORKER_POLL_SECONDS=3

# Legacy review channels (only used when review bot is NOT configured)
# Prefer TELEGRAM_REVIEW_BOT_TOKEN + TELEGRAM_REVIEW_CHAT_ID instead.
# @KayaProjectsBot — Freelancer bids check
TELEGRAM_CHANNEL_ID=
# Freelancer API matches
TELEGRAM_FREELANCER_CHANNEL_ID=
# LinkedIn jobs / ATS
TELEGRAM_LINKEDIN_CHANNEL_ID=

# AI provider: groq | gemini | deepseek | anthropic | openai
# Optional: separate providers for screening vs proposals (saves Groq quota)
# AI_SCREENING_PROVIDER=gemini
# AI_PROPOSAL_PROVIDER=groq
# AI_SCREENING_MODEL=gemini-2.0-flash
# AI_PROPOSAL_MODEL=llama-3.3-70b-versatile
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# Auto-bid: vector match confidence >= this value triggers automatic bidding (default 85)
AUTO_BID_CONFIDENCE_THRESHOLD=85

# Max bids per calendar day (UTC)
MAX_BIDS_PER_DAY=5

# Test mode: ON = AI runs but NO bids sent to Telegram (safe for testing)
TEST_MODE=true

# Freelancer API (sandbox: https://accounts.freelancer-sandbox.com)
FREELANCER_CLIENT_ID=
FREELANCER_CLIENT_SECRET=
FREELANCER_SANDBOX=true
FREELANCER_REDIRECT_URI=http://127.0.0.1:8000/api/freelancer/callback
FREELANCER_ADVANCED_SCOPES=1
# Bidding is OFF by default — enable in Settings → Connections after OAuth connect

# LinkedIn — Sign In with LinkedIn (https://www.linkedin.com/developers/apps)
# Add redirect URL: http://127.0.0.1:8000/api/linkedin/callback
# Product: "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/api/linkedin/callback

# Sellable plans (edit these to your real prices)
PLAN_CURRENCY=USD
PLAN_PRICE_1_MONTH=9.99
PLAN_PRICE_3_MONTH=24.99
PLAN_PRICE_6_MONTH=44.99
PLAN_PRICE_12_MONTH=79.99
# Optional add-ons: monthly rate × plan months added to total
PLAN_AI_ADDON_PER_MONTH=4.99
PLAN_ATS_ADDON_PER_MONTH=4.99

# Card-to-card payment (shown after user confirms a plan)
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_BANK_NAME=
# Optional note shown under the card details (e.g. "Include order id in transfer note")
PAYMENT_EXTRA_NOTE=

# Server
HOST=127.0.0.1
PORT=8000
