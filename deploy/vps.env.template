# LinkedIn Job Finder — VPS env (isolated from job-tracker + clinic-mailer)
# App path: /home/deploy/linkedin-job-finder
# HTTP: 127.0.0.1:8001  (do NOT use 8000 — that is job-tracker)
# PM2 name: linkedin-job-finder

# REQUIRED — dedicated BotFather bot (multi-user; each user chats privately)
TELEGRAM_REVIEW_BOT_TOKEN=

# OPTIONAL — your personal chat id for card-to-card receipt alerts / Activate
TELEGRAM_REVIEW_CHAT_ID=

# Your Telegram user id(s) for admin panel (prices + card details)
# Example: TELEGRAM_ADMIN_IDS=123456789
TELEGRAM_ADMIN_IDS=

# AI
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Sellable plans
PLAN_CURRENCY=IRR
PLAN_PRICE_1_MONTH=9.99
PLAN_PRICE_3_MONTH=24.99
PLAN_PRICE_6_MONTH=44.99
PLAN_PRICE_12_MONTH=79.99
PLAN_AI_ADDON_PER_MONTH=4.99
PLAN_ATS_ADDON_PER_MONTH=4.99

# Card-to-card
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_BANK_NAME=
PAYMENT_EXTRA_NOTE=

# Optional LinkedIn OAuth (only if you use it)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8001/api/linkedin/callback

# Heavy work on PC worker (optional)
QUEUE_HEAVY_WORK=false
WORKER_API_SECRET=

SYSTEM_ALERTS_ENABLED=true
HOST=127.0.0.1
PORT=8001
TEST_MODE=true
